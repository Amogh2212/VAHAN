{
  "name": "vahan-ey-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check:syntax",
    "dev": "node --env-file=.env server.mjs",
    "start": "node server.mjs",
    "test": "npm run check:syntax && npm run check:local",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:audit": "npm audit --omit=dev",
    "check:production": "node scripts/production-smoke-check.mjs",
    "data:tdc": "node scripts/download-tdc-history.mjs",
    "db:schema": "node --env-file=.env scripts/apply-neon-schema.mjs",
    "import:neon": "node --env-file=.env scripts/import-to-neon.mjs",
    "scrape:vahan": "node --env-file=.env scripts/vahan-scraper.mjs",
    "scrape:vahan:discover": "node --env-file=.env scripts/vahan-scraper.mjs --mode discover",
    "scrape:vahan:rto-catalog": "node --env-file=.env scripts/vahan-scraper.mjs --mode rto-catalog",
    "scrape:vahan:sample": "node --env-file=.env scripts/vahan-scraper.mjs --mode scrape --states Maharashtra --years 2024 --months 1",
    "check:local": "node scripts/local-regression-check.mjs",
    "query:random": "node scripts/random-query-runner.mjs",
    "query:random:live": "node scripts/random-query-runner.mjs --live --resume --count 100 --seed 20260601 --output reports/random-query-live-2026-06-01.json",
    "tracked:run": "node --env-file=.env scripts/run-tracked-queries.mjs",
    "tracked:dry-run": "node --env-file=.env scripts/run-tracked-queries.mjs --dry-run"
  },
  "dependencies": {
    "pg": "^8.20.0",
    "playwright": "^1.52.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
