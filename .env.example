NODE_ENV=production
PORT=3000

# Required for database-backed features. For local PostgreSQL use:
# postgresql://vahan_app:YOUR_PASSWORD@localhost:5433/vahan_ey_local?sslmode=disable
DATABASE_URL=
# Set false for local PostgreSQL and true for cloud PostgreSQL-compatible databases.
PGSSL=true
DB_MAX_RETRIES=3
DB_RETRY_BASE_MS=100
REQUIRE_DATABASE_FOR_READINESS=1

# Parallel all-RTO daily collector. Keep workers between 1 and 4.
RTO_DAILY_WORKERS=2
RTO_DAILY_RETENTION_DAYS=30
RTO_DAILY_DELAY_MS=1200
RTO_DAILY_JITTER_MS=400
RTO_DAILY_MAX_JOB_ATTEMPTS=3
RTO_DAILY_MAX_PINS_PER_USER=10
RTO_DAILY_WORK_BUDGET_MINUTES=10
RTO_CATALOG_LOCK_WAIT_MS=1800000

# Public base URL must match the deployed hostname.
APP_BASE_URL=https://your-production-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-production-domain.example/auth/google/callback
SESSION_DAYS=30
AUTH_PROVIDER_TIMEOUT_MS=10000
# Comma-separated verified Google accounts allowed to trigger administrative work.
ADMIN_EMAILS=
# Required in production. Generate at least 32 random characters and keep it in a secret manager.
CSRF_SECRET=

# Dashboard intent decoding is explicit opt-in. Use `groq` for the cloud
# interpreter (with the configured GROQ_API_KEY), `ollama` for local-only, or
# `none` for deterministic parsing. The factor narrative provider stays separate.
AI_QUERY_PROVIDER=none
# `shadow` records the same routing decisions without weakening fail-closed
# execution. `enforced` is the safe production default and skips AI for local
# deterministic queries.
DASHBOARD_QUERY_ROUTING_MODE=enforced
GROQ_MODEL=llama-3.1-8b-instant
# Groq calls stay sequential, cache unique queries for 24 hours, and wait at
# least 30 seconds. Successful quota headers also hold one daily request in
# reserve and require 1.25x the previous token usage before another call.
# During a quota window, repair-required queries ask for clarification instead
# of silently using a weak local interpretation. Checkpointed audits wait for
# the reset timestamp and then continue the same case. A 429 pauses the
# provider for at least five minutes.
GROQ_AI_MIN_INTERVAL_MS=30000
GROQ_AI_CACHE_TTL_MS=86400000
GROQ_AI_RATE_LIMIT_COOLDOWN_MS=300000
GROQ_AI_TIMEOUT_MS=10000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_QUERY_MODEL=qwen3:4b
OLLAMA_FACTOR_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=10000

# Cloud compatibility keys are not used by the local-only configuration.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Evidence-backed RTO report context agent. Disabled and draft-only by default.
# This worker never starts VAHAN scraping and approved text still requires an admin review.
FACTOR_AGENT_ENABLED=0
FACTOR_AGENT_MODE=draft_only
# Set to `ollama` only after `node scripts/check-ollama.mjs` passes.
FACTOR_AGENT_PROVIDER=none
FACTOR_AGENT_MIN_PRE_DAYS=28
FACTOR_AGENT_MIN_POST_DAYS=14
FACTOR_AGENT_MIN_CONTROLS=5
FACTOR_AGENT_MIN_COVERAGE_PCT=90
# Explicit activation gate for the separate daily factor task. It writes only
# validation records and review-only drafts; it never publishes explanations.
FACTOR_DAILY_AUTOMATION_ENABLED=0
FACTOR_DAILY_VALIDATION_LIMIT=200

# Telegram command center and alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ENABLE_POLLING=0
TELEGRAM_ALERT_THRESHOLD_POINTS=2
TELEGRAM_PUBLIC_DAILY_LIMIT=0
TELEGRAM_SUMMARY_FETCH_MISSING=0

# Production safety controls. Set to 1 only during a maintenance window.
# Supported missing queries otherwise return immediately and scrape in the background.
VAHAN_DISABLE_LIVE_REFRESH=0
MAX_JSON_BODY_BYTES=65536
MAX_QUERY_CHARACTERS=1000
RATE_LIMIT_STORE=database
# Number of known reverse proxies between the public client and this process. Keep 0 for direct access.
TRUST_PROXY_HOPS=0
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_GLOBAL_MAX=6000
EXPENSIVE_RATE_LIMIT_WINDOW_MS=60000
EXPENSIVE_RATE_LIMIT_MAX=20
EXPENSIVE_RATE_LIMIT_GLOBAL_MAX=1000
REFRESH_JOB_TTL_MS=1800000
MAP_REFRESH_JOB_TTL_MS=3600000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
AI_PROVIDER_TIMEOUT_MS=15000
MAX_EXPENSIVE_CONCURRENCY=4

# Daily tracked query defaults.
TRACKED_QUERY_DEFAULT_TIMEZONE=Asia/Calcutta
TRACKED_QUERY_DEFAULT_RUN_TIME=08:00
TRACKED_QUERY_RUN_TIMEOUT_MS=300000
TRACKED_QUERY_FAIL_ON_PARTIAL=0
TRACKED_QUERY_BACKFILL_DAYS=7

# Local PostgreSQL backups (optional).
BACKUP_DIR=backups/postgres
BACKUP_RETENTION_DAYS=14
LOCAL_POSTGRES_DATA_DIR=.local/postgres/data

# Codex validation-report delivery (not used by the dashboard server).
# Set this before requesting Gmail delivery; never commit a real address in this example file.
GMAIL_REPORT_RECIPIENT=
