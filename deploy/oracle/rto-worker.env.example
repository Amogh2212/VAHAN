# Store the real file outside the repository at /etc/vahan-ey/rto-worker.env
# Never commit the Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require
PGSSL=true
RTO_DAILY_WORKERS=1
RTO_DAILY_RETENTION_DAYS=30
RTO_DAILY_DELAY_MS=1200
RTO_DAILY_JITTER_MS=400
RTO_DAILY_MAX_JOB_ATTEMPTS=3
RTO_DAILY_WORK_BUDGET_MINUTES=55
